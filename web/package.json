{
  "name": "novelupdates-recommender-ui",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:static": "tsc && VITE_DATA_MODE=static vite build",
    "build:pages": "tsc && VITE_DATA_MODE=static vite build --base=/NovelCompass/",
    "check": "pnpm run lint && pnpm run format:check && pnpm run typecheck && pnpm run test && pnpm run build",
    "format": "prettier --write --ignore-path ../.prettierignore package.json ../README.md ../DEPLOYMENT.md '../.github/workflows/*.yml'",
    "format:check": "prettier --check --ignore-path ../.prettierignore package.json ../README.md ../DEPLOYMENT.md '../.github/workflows/*.yml'",
    "lint": "oxlint --react-plugin --deny-warnings src",
    "lint:fix": "oxlint --react-plugin --fix src",
    "smoke:static": "node ../scripts/smoke_static_preview.mjs",
    "test": "cd .. && ( [ -f .venv/bin/pytest ] && PYTHONPATH=. .venv/bin/pytest -q || PYTHONPATH=. python3 -m pytest -q )",
    "typecheck": "tsc --noEmit",
    "prepare": "git config core.hooksPath ../.githooks || true",
    "preview": "vite preview"
  },
  "dependencies": {
    "3d-force-graph": "^1.80.0",
    "@base-ui/react": "^1.6.0",
    "@types/three": "^0.185.1",
    "force-graph": "^1.51.4",
    "lucide-react": "^0.263.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recharts": "^3.10.1",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@vitejs/plugin-react": "^4.0.0",
    "oxlint": "^1.75.0",
    "prettier": "^3.9.6",
    "typescript": "^5.0.2",
    "vite": "^4.3.9"
  }
}
