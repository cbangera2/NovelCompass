{
  "name": "novelupdates-recommender-ui",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:static": "tsc && VITE_DATA_MODE=static vite build",
    "build:pages": "tsc && VITE_DATA_MODE=static vite build --base=/NovelCompass/",
    "build:extension": "pnpm run build:extension:core",
    "build:extension:core": "tsc -p ../extension/tsconfig.json && node ../extension/build.mjs",
    "build:extension:fixture": "tsc -p ../extension/tsconfig.json && node ../extension/build.mjs --fixture-data",
    "build:extension:offline-full": "tsc -p ../extension/tsconfig.json && node ../extension/build.mjs --offline-full",
    "build:extension:full": "pnpm run build:extension:offline-full",
    "dev:extension": "node ../extension/build.mjs --watch",
    "fixtures:extension": "node ../scripts/serve_extension_fixtures.mjs",
    "package:extension": "pnpm run build:extension:core && node ../scripts/validate_extension_package.mjs --mode=core",
    "package:extension:fixture": "pnpm run build:extension:fixture && node ../scripts/validate_extension_package.mjs --mode=fixture",
    "package:extension:offline-full": "pnpm run build:extension:offline-full && node ../scripts/validate_extension_package.mjs --mode=offline-full",
    "test:extension": "vitest run --config ../extension/vitest.config.ts",
    "validate:extension": "node ../scripts/validate_extension_package.mjs --mode=core",
    "check": "pnpm run lint && pnpm run format:check && pnpm run typecheck && pnpm run test && pnpm run build",
    "format": "prettier --write --ignore-path ../.prettierignore package.json ../README.md ../DEPLOYMENT.md '../.github/workflows/*.yml'",
    "format:check": "prettier --check --ignore-path ../.prettierignore package.json ../README.md ../DEPLOYMENT.md '../.github/workflows/*.yml'",
    "lint": "oxlint --react-plugin --deny-warnings src",
    "lint:fix": "oxlint --react-plugin --fix src",
    "smoke:static": "node ../scripts/smoke_static_preview.mjs",
    "test": "cd .. && ( [ -f .venv/bin/pytest ] && PYTHONPATH=. .venv/bin/pytest -q || PYTHONPATH=. python3 -m pytest -q )",
    "typecheck": "tsc --noEmit",
    "prepare": "git config core.hooksPath ../.githooks || true",
    "preview": "vite preview"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "lucide-react": "^0.263.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.2",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@vitejs/plugin-react": "^4.0.0",
    "happy-dom": "^18.0.1",
    "oxlint": "^1.75.0",
    "prettier": "^3.9.6",
    "typescript": "^5.0.2",
    "vite": "^4.3.9",
    "vitest": "^3.2.7"
  }
}
